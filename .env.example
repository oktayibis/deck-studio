# Deck Studio Server Configuration
PORT=3456
HOST=127.0.0.1

# Database
DATABASE_URL=sqlite://data/deck_studio.sqlite

# LLM Provider Configuration
LLM_PROVIDER=local-structured
LLM_MODEL=deck-architect-v4
LLM_API_KEY=

# Network & Media Security (On-Premises / Air-Gapped)
INTERNAL_NETWORK_ONLY=true
FORBID_EXTERNAL_MEDIA=false
